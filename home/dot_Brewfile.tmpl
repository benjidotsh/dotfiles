# Homebrew strips NODE_EXTRA_CA_CERTS
ENV["NODE_EXTRA_CA_CERTS"] = "#{Dir.home}/.zcli/zscaler_root.pem"
{{ range .packages.taps -}}
tap "{{ . }}", trusted: true
{{ end }}
{{ range .packages.formulae -}}
brew "{{ . }}"
{{ end }}
{{ range .packages.casks -}}
cask "{{ . }}"
{{ end }}
{{ range .packages.mas -}}
mas "{{ .name }}", id: {{ .id }}
{{ end }}
{{ range .packages.vscode -}}
vscode "{{ . }}"
{{ end -}}
