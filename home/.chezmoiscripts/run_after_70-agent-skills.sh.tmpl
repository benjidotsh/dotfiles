#!/bin/sh
set -eu

skills=/opt/homebrew/bin/skills

# "<source> <member>" per line; a "*" member marks a source whose membership
# follows upstream.
manifest='
{{- range $source, $members := .skills }}
{{- if kindIs "string" $members }}
{{ $source }} {{ $members }}
{{- else }}
{{- range $members }}
{{ $source }} {{ . }}
{{- end }}
{{- end }}
{{- end }}'

# The CLI prints spinners and ANSI noise even when piped; keep converged
# applies silent and surface the log only on failure.
run_logged() {
  log=$(mktemp)
  if "$@" >"$log" 2>&1; then
    rm -f "$log"
  else
    status=$?
    cat "$log" >&2
    rm -f "$log"
    exit "$status"
  fi
}

# Well-known sources (bare hosts like backstage.io) are recorded bare in the
# lockfile, but `skills add` only accepts them as a URL.
source_url() {
  case $1 in
  */*) printf '%s\n' "$1" ;;
  *) printf 'https://%s\n' "$1" ;;
  esac
}

# "<source> <name>" per installed global skill; [] (so no output) on a fresh
# machine where not even the lockfile exists yet.
installed() {
  "$skills" ls --global --json | /usr/bin/python3 -c '
import json, sys
for skill in json.load(sys.stdin):
    print(skill["source"], skill["name"])'
}

# `skills add --list` has no JSON mode: names sit in a box-drawing frame,
# indented four spaces (descriptions six) under an "Available Skills" heading.
# The C locale keeps BSD tr byte-wise and stops BSD awk rejecting the invalid
# UTF-8 remnants that byte-wise stripping leaves behind.
upstream_members() {
  "$skills" add "$(source_url "$1")" --list |
    sed "s/$(printf '\033')\\[[0-9;]*m//g" |
    LC_ALL=C tr -d '\342\224\202' |
    LC_ALL=C awk '/Available Skills/ { in_list = 1; next }
      in_list && /^    [^ ]+ *$/ { print $1 }'
}

installed_pairs=$(installed)
declared_names=''

for source in $(printf '%s\n' "$manifest" | awk 'NF { print $1 }' | sort -u); do
  members=$(printf '%s\n' "$manifest" | awk -v s="$source" '$1 == s { print $2 }')
  if [ "$members" = '*' ]; then
    members=$(upstream_members "$source")
    # An empty listing is far more likely a network or parsing regression than
    # a source that deleted its every skill; it must neither mass-prune nor
    # abort the apply, so keep this source's installed members declared and
    # move on to the other sources.
    if [ -z "$members" ]; then
      echo "skills: no upstream skills listed for $source; skipping it this run" >&2
      declared_names="$declared_names$(printf '%s\n' "$installed_pairs" | awk -v s="$source" '$1 == s { print $2 }')
"
      continue
    fi
  fi

  missing=''
  for name in $members; do
    declared_names="$declared_names$name
"
    printf '%s\n' "$installed_pairs" | grep -qxF "$source $name" || missing="$missing $name"
  done

  if [ -n "$missing" ]; then
    echo "skills: installing$missing from $source"
    # Targeting claude-code alone makes the CLI copy into ~/.claude/skills and
    # bypass the canonical store; codex is what routes content into
    # ~/.agents/skills, with ~/.claude/skills symlinked to it.
    # shellcheck disable=SC2086
    run_logged "$skills" add "$(source_url "$source")" --global --yes \
      --agent claude-code codex --skill $missing
  fi
done

run_logged "$skills" update --global --yes

# `skills update` never deletes, so undeclared members (including upstream
# deletions under a "*" source) must be pruned here. No --agent on remove:
# that cleans the links from every agent directory. Bare names are the removal
# identity: the lockfile keys skills by name (one per name), and the install
# loop's source+name check already reinstalled any declared name that was
# installed from an undeclared source.
prune=''
for name in $(installed | awk '{ print $2 }'); do
  printf '%s\n' "$declared_names" | grep -qxF "$name" || prune="$prune $name"
done

if [ -n "$prune" ]; then
  # shellcheck disable=SC2086
  run_logged "$skills" remove $prune --global --yes
  for name in $prune; do
    echo "skills: pruned $name"
  done
fi
