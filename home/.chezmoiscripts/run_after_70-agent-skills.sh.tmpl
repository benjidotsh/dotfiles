#!/bin/sh
# noglob: the script word-splits unquoted variables on purpose; a stray glob
# character in the manifest must stay literal instead of matching files.
set -euf

skills=/opt/homebrew/bin/skills

# One "<source> <members...>" line per source. Membership must be explicit:
# a "*" would be expanded by the CLI itself into every upstream skill, so it
# is rejected before anything runs.
manifest='
{{- range $source, $members := .skills }}
{{- if kindIs "string" $members }}
{{-   fail (printf "skills manifest: source %q must list explicit skill names" $source) }}
{{- end }}
{{ $source }} {{ join " " $members }}
{{- end }}'

# The CLI prints spinners and ANSI noise even when piped; keep converged
# applies silent and surface the output only on failure. /dev/null stdin stops
# the CLI from swallowing the manifest here-doc that feeds the loop below.
run_logged() {
  out=$("$@" </dev/null 2>&1) || {
    status=$?
    printf '%s\n' "$out" >&2
    exit "$status"
  }
}

# "<source> <name>" per installed global skill; [] (so no output) on a fresh
# machine where not even the lockfile exists yet.
installed_pairs=$("$skills" ls --global --json | /usr/bin/python3 -c '
import json, sys
for skill in json.load(sys.stdin):
    print(skill["source"], skill["name"])')

declared_names=''

while read -r source members; do
  [ -n "$source" ] || continue

  # shellcheck disable=SC2086
  declared_names="$declared_names$(printf '%s\n' $members)
"
  # The multi-line set travels as an environment variable: BSD awk -v rejects
  # values containing newlines.
  # shellcheck disable=SC2086
  missing=$(printf '%s\n' $members | pairs="$installed_pairs" awk -v s="$source" '
    BEGIN {
      n = split(ENVIRON["pairs"], line, "\n")
      for (i = 1; i <= n; i++) {
        split(line[i], f, " ")
        if (f[1] == s) seen[f[2]]
      }
    }
    !($0 in seen) { printf " %s", $0 }')

  if [ -n "$missing" ]; then
    echo "skills: installing$missing from $source"
    # Targeting claude-code alone makes the CLI copy into ~/.claude/skills and
    # bypass the canonical store; codex is what routes content into
    # ~/.agents/skills, with ~/.claude/skills symlinked to it.
    # shellcheck disable=SC2086
    run_logged "$skills" add "$source" --global --yes \
      --agent claude-code codex --skill $missing
  fi
done <<EOF
$manifest
EOF

run_logged "$skills" update --global --yes

# `skills update` never installs or deletes, and everything the install loop
# added was declared first, so the pre-install snapshot still decides the
# prune set. Undeclared members go here; no --agent on remove: that cleans the
# links from every agent directory. Bare names are the removal identity: the
# lockfile keys skills by name (one per name), and the install loop's
# source+name check already reinstalled any declared name installed from an
# undeclared source.
prune=$(printf '%s\n' "$installed_pairs" | declared="$declared_names" awk '
  BEGIN {
    n = split(ENVIRON["declared"], a, "\n")
    for (i = 1; i <= n; i++) seen[a[i]]
  }
  NF && !($2 in seen) { printf " %s", $2 }')

if [ -n "$prune" ]; then
  # shellcheck disable=SC2086
  run_logged "$skills" remove $prune --global --yes
  for name in $prune; do
    echo "skills: pruned $name"
  done
fi
