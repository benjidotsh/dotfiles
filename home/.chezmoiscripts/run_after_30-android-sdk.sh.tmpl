{{ if eq .profile "personal" -}}
#!/bin/sh
set -eu

sdk_root="$HOME/Library/Android/sdk"
sdkmanager=/opt/homebrew/bin/sdkmanager

mkdir -p "$sdk_root"
yes | "$sdkmanager" --sdk_root="$sdk_root" --licenses
"$sdkmanager" --sdk_root="$sdk_root" --update
"$sdkmanager" --sdk_root="$sdk_root" \
  platform-tools \
  emulator
{{ end -}}
