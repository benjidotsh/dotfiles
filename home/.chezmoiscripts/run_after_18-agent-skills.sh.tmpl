{{- $extra := index .skills .profile -}}
{{- $agents := concat .skills.common.agents $extra.agents -}}
{{- $declared := merge (dict) .skills.common.skills $extra.skills -}}
#!/bin/sh
set -eu

skills=/opt/homebrew/bin/skills

"$skills" remove --all --global --yes
{{ range $remote, $names := $declared -}}
"$skills" add {{ $remote | quote }} --global --yes --agent{{ range $agents }} {{ . | quote }}{{ end }} --skill{{ range $names }} {{ . | quote }}{{ end }}
{{ end -}}
