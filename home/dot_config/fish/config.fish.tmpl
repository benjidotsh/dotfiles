/opt/homebrew/bin/brew shellenv fish | source

set -gx EDITOR 'code --wait'
set -gx VOLTA_HOME "$HOME/.volta"
fish_add_path --move --path "$VOLTA_HOME/bin"
{{- if eq .profile "personal" }}
set -gx JAVA_HOME /Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home
set -gx ANDROID_HOME "$HOME/Library/Android/sdk"
fish_add_path --append --path "$ANDROID_HOME/emulator" "$ANDROID_HOME/platform-tools"
{{- else }}
set -gx AWS_CA_BUNDLE /opt/homebrew/etc/ca-certificates/cert.pem
set -gx NODE_EXTRA_CA_CERTS "$HOME/.zcli/zscaler_root.pem"
set -gx GONOSUMDB 'persgroep.cloud/*'
fish_add_path --append --path "$HOME/go/bin"
{{- end }}

if status is-interactive
    set -g fish_greeting
    starship init fish | source
end
